			<script name="SQL_Editor_003" id="228817bd-189c-4ff5-8068-3fc57bb1bf62" language="SQL" >
				<string><![CDATA[CREATE SCHEMA IF NOT EXISTS shoe_store_chain;

CREATE  TABLE shoe_store_chain.branch ( 
	branch_id            integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	name                 varchar(100)  NOT NULL  ,
	address              varchar(100)  NOT NULL  ,
	phone                varchar(100)  NOT NULL  ,
	opening_date         date  NOT NULL  ,
	closing_date         date    ,
	CONSTRAINT pk_branch PRIMARY KEY ( branch_id )
 ) ;

CREATE  TABLE shoe_store_chain.customer ( 
	customer_id          integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	first_name           varchar(100)  NOT NULL  ,
	last_name            varchar(100)  NOT NULL  ,
	national_id          varchar(100)  NOT NULL  ,
	email                varchar  NOT NULL  ,
	phone                varchar(100)  NOT NULL  ,
	created_at           timestamptz  NOT NULL  ,
	deactivated_at       timestamptz    ,
	CONSTRAINT pk_customer PRIMARY KEY ( customer_id )
 ) ;

CREATE  TABLE shoe_store_chain.employee ( 
	employee_id          integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	first_name           varchar(100)  NOT NULL  ,
	last_name            varchar(100)  NOT NULL  ,
	national_id          varchar(100)  NOT NULL  ,
	date_of_birth        date  NOT NULL  ,
	created_at           timestamptz  NOT NULL  ,
	deactivated_at       timestamptz    ,
	CONSTRAINT pk_employee PRIMARY KEY ( employee_id )
 ) ;

CREATE  TABLE shoe_store_chain.payment_method ( 
	payment_method_id    integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	name                 varchar(100)  NOT NULL  ,
	created_at           timestamptz  NOT NULL  ,
	deactivated_at       timestamptz    ,
	CONSTRAINT pk_payment_method PRIMARY KEY ( payment_method_id )
 ) ;

CREATE  TABLE shoe_store_chain.product ( 
	product_id           integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	product_name         varchar(100)  NOT NULL  ,
	brand                varchar(100)  NOT NULL  ,
	category             varchar(100)  NOT NULL  ,
	season               varchar(100)  NOT NULL  ,
	created_at           timestamptz  NOT NULL  ,
	discontinued_at      timestamptz    ,
	CONSTRAINT pk_product PRIMARY KEY ( product_id )
 ) ;

CREATE  TABLE shoe_store_chain.product_model ( 
	model_id             integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	product_id           integer  NOT NULL  ,
	"size"               varchar  NOT NULL  ,
	color                varchar(100)  NOT NULL  ,
	sku                  varchar(100)  NOT NULL  ,
	created_at           timestamptz  NOT NULL  ,
	discontinued_at      timestamptz    ,
	CONSTRAINT pk_product_model PRIMARY KEY ( model_id )
 ) ;

CREATE UNIQUE INDEX unq_product_model ON shoe_store_chain.product_model ( sku ) ;

CREATE  TABLE shoe_store_chain.price_history ( 
	price_id             integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	model_id             integer  NOT NULL  ,
	price                numeric(10,2)  NOT NULL  ,
	valid_from           date  NOT NULL  ,
	valid_to             date    ,
	CONSTRAINT pk_price_history PRIMARY KEY ( price_id )
 ) ;

CREATE  TABLE shoe_store_chain.product_model_x_branch ( 
	branch_id            integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	model_id             integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	quantity             integer  NOT NULL  ,
	updated_at           timestamptz  NOT NULL  ,
	CONSTRAINT pk_product_model_x_branch PRIMARY KEY ( branch_id, model_id )
 ) ;

CREATE  TABLE shoe_store_chain."role" ( 
	role_id              integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	role_description     varchar(100)  NOT NULL  ,
	created_at           timestamptz  NOT NULL  ,
	deactivated_at       timestamptz    ,
	CONSTRAINT pk_role PRIMARY KEY ( role_id )
 ) ;

CREATE  TABLE shoe_store_chain.employee_period ( 
	emp_period_id        integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	employee_id          integer  NOT NULL  ,
	branch_id            integer  NOT NULL  ,
	role_id              integer  NOT NULL  ,
	start_date           date  NOT NULL  ,
	end_date             date    ,
	CONSTRAINT pk_employee_period PRIMARY KEY ( emp_period_id )
 ) ;

CREATE  TABLE shoe_store_chain.sales_channel ( 
	channel_id           integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	name                 varchar(100)  NOT NULL  ,
	created_at           timestamptz  NOT NULL  ,
	deactivated_at       timestamptz    ,
	CONSTRAINT pk_sales_channel PRIMARY KEY ( channel_id )
 ) ;

CREATE  TABLE shoe_store_chain.receipt_header ( 
	receipt_id           integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	branch_id            integer  NOT NULL  ,
	emp_period_id        integer    ,
	customer_id          integer    ,
	channel_id           integer  NOT NULL  ,
	delivery_type        varchar    ,
	datetime             timestamptz  NOT NULL  ,
	status               varchar  NOT NULL  ,
	total                numeric(10,2)  NOT NULL  ,
	CONSTRAINT pk_receipt_header PRIMARY KEY ( receipt_id )
 ) ;

CREATE  TABLE shoe_store_chain.receipt_detail ( 
	detail_id            integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	receipt_id           integer  NOT NULL  ,
	model_id             integer  NOT NULL  ,
	quantity             integer  NOT NULL  ,
	unit_price           numeric(10,2)  NOT NULL  ,
	subtotal             numeric(10,2)  NOT NULL  ,
	CONSTRAINT pk_receipt_detail PRIMARY KEY ( detail_id )
 ) ;

CREATE  TABLE shoe_store_chain.receipt_payment ( 
	payment_id           integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	receipt_id           integer  NOT NULL  ,
	payment_method_id    integer  NOT NULL  ,
	amount               numeric(10,2)  NOT NULL  ,
	created_at           timestamptz  NOT NULL  ,
	CONSTRAINT pk_receipt_payment PRIMARY KEY ( payment_id )
 ) ;

CREATE  TABLE shoe_store_chain."return" ( 
	return_id            integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	receipt_id           integer  NOT NULL  ,
	"date"               date  NOT NULL  ,
	reason               varchar(100)  NOT NULL  ,
	status               varchar  NOT NULL  ,
	CONSTRAINT pk_return PRIMARY KEY ( return_id )
 ) ;

CREATE  TABLE shoe_store_chain.return_detail ( 
	return_detail_id     integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	detail_id            integer  NOT NULL  ,
	return_id            integer  NOT NULL  ,
	quantity_returned    integer  NOT NULL  ,
	CONSTRAINT pk_return_detail PRIMARY KEY ( return_detail_id )
 ) ;

CREATE  TABLE shoe_store_chain.shipment ( 
	shipment_id          integer  NOT NULL GENERATED ALWAYS  AS IDENTITY ,
	receipt_id           integer  NOT NULL  ,
	carrier              varchar(100)  NOT NULL  ,
	tracking_number      varchar(100)  NOT NULL  ,
	delivery_address     varchar(100)  NOT NULL  ,
	status               varchar  NOT NULL  ,
	shipped_at           timestamptz  NOT NULL  ,
	delivered_at         timestamptz    ,
	CONSTRAINT pk_shipment PRIMARY KEY ( shipment_id ),
	CONSTRAINT unq_shipment UNIQUE ( receipt_id ) 
 ) ;

