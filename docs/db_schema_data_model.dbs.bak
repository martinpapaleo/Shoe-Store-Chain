<project name="Shoe-Store-Chain" database="LogicalDesign" id="65710a27-f10e-4a9d-8c61-f4c2ad7e9b67" >
	<schema name="Shoe-Store-Chain" >
		<table name="BRANCH" prior="BRAN" >
